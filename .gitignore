# macOS
.DS_Store
._*

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Build output. The packaged app is ~190 MB and the archive ~76 MB — far too large for git
# history, and it is fully reproducible with `python3 build_app.py`. Ship it as a GitHub Release
# asset instead, so downloads are versioned without bloating every clone.
build/
dist/
*.spec

# Analysis output written next to an input file
*_results/
results/

# Secrets. The Anthropic key belongs in ~/.survey_segmenter/config.json (chmod 600), never here.
.env
*.key

# Real survey data must never be committed — it is personal data. Only the synthetic file in
# examples/ is tracked; anything else you drop in for testing stays local.
*.csv
*.xlsx
!examples/*.csv

# Node. node_modules is 5,885 files; webui/ is the build output and IS committed on purpose —
# it is what the Python app serves, so a clone runs without Node and PyInstaller has something
# to bundle. CI rebuilds it and fails if the committed copy has drifted from frontend/.
frontend/node_modules/
frontend/.vite/
frontend/*.tsbuildinfo

# The reference library itself: 604 MB of copyrighted books and papers that live outside the
# repository. references/README.md indexes them and IS committed.
references/*.pdf
