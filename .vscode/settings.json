{
  // Project settings, committed on purpose: everyone opening this folder gets the same
  // formatting rules and the same things hidden, rather than whatever their global config says.

  // 100 columns is what the Python here is written to. The ruler makes that visible instead of
  // something you discover from a lint error.
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.typeCheckingMode": "basic",

  "[python]": {
    "editor.tabSize": 4,
    "editor.detectIndentation": false
  },
  "[typescript]": { "editor.tabSize": 2, "editor.detectIndentation": false },
  "[typescriptreact]": { "editor.tabSize": 2, "editor.detectIndentation": false },
  "[json]": { "editor.tabSize": 2 },

  // Hidden because they are generated and never edited by hand. webui/ is deliberately NOT
  // hidden: it is committed, and someone should be able to see that it exists and read its
  // README explaining why.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true,
    "**/node_modules": true,
    "**/.vite": true,
    "build": true,
    "dist": true
  },
  // Excluded from search rather than from view: searching for a string should not return
  // thousands of hits inside a compiled bundle or a lockfile.
  "search.exclude": {
    "webui/assets": true,
    "frontend/package-lock.json": true,
    "**/node_modules": true
  },

  "eslint.enable": false,
  "typescript.tsdk": "frontend/node_modules/typescript/lib"
}
